# ==========================================
# IRCTC Telegram AI Agent Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Fernet Master Encryption Key (Optional - will auto-generate if blank)
ENCRYPTION_KEY=

# 3. Credit Card Details for Auto-Payment
CARD_NUMBER=4111222233334444
CARD_EXPIRY=12/28
CARD_CVV=123
CARD_HOLDER=BALAJI P

# 4. Monitoring & Polling Settings
POLL_INTERVAL_SECONDS=60
OTP_TIMEOUT_SECONDS=120

# 5. Cloud Key-Value Storage (100% Free Forever)
# Get a free Redis database at https://console.upstash.com (Zero setup, no credit card required)
# Survives all Render/Koyeb container redeployments and git pushes
REDIS_URL=rediss://default:your_password@your_endpoint.upstash.io:6379

# Alternative: Upstash REST API (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
